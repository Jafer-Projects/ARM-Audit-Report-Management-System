{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARM — Audit Report Management",
  "version": "0.1.0",
  "identifier": "com.arm.audit-report-management",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ARM — Audit Report Management",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  }
}
