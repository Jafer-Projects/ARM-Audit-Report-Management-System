NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://arm_runtime:replace-with-runtime-password@localhost:5432/arm
WORKER_DATABASE_URL=postgres://arm_worker:replace-with-worker-password@localhost:5432/arm
MIGRATION_DATABASE_URL=postgres://arm_owner:replace-with-owner-password@localhost:5432/arm
# Generate with: openssl rand -base64 48. Use a different secret per environment.
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
LOG_LEVEL=info
# Required by server/compose.yaml for the local PostgreSQL container.
POSTGRES_PASSWORD=replace-with-a-long-random-owner-password
ARM_RUNTIME_PASSWORD=replace-with-a-different-random-runtime-password
ARM_WORKER_PASSWORD=replace-with-a-third-random-worker-password
