# Copy to a protected deployment environment file. Never commit secret files.
NODE_ENV=production
PUBLIC_APP_URL=https://app.example.com
EMAIL_PROVIDER_URL=https://api.resend.com/emails
EMAIL_FROM=security@example.com
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420
TLS_CERT_DIR=/secure/tls/certificate-directory

# Paths to secret files; file contents are raw values without surrounding quotes.
POSTGRES_PASSWORD_FILE=/secure/secrets/postgres-password
ARM_RUNTIME_PASSWORD_FILE=/secure/secrets/arm-runtime-password
ARM_WORKER_PASSWORD_FILE=/secure/secrets/arm-worker-password
ARM_MIGRATOR_PASSWORD_FILE=/secure/secrets/arm-migrator-password
API_DATABASE_URL_FILE=/secure/secrets/api-database-url
WORKER_DATABASE_URL_FILE=/secure/secrets/worker-database-url
MIGRATOR_DATABASE_URL_FILE=/secure/secrets/migrator-database-url
JWT_SECRET_FILE=/secure/secrets/jwt-secret
MFA_ENCRYPTION_KEY_FILE=/secure/secrets/mfa-encryption-key
EMAIL_PROVIDER_API_KEY_FILE=/secure/secrets/email-provider-api-key

# Use a private, non-public S3 bucket with server-side encryption and a least-privilege access key.
OBJECT_STORAGE_MODE=s3
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=arm-private-evidence
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-limited-scope-access-key
S3_SECRET_ACCESS_KEY_FILE=/secure/secrets/s3-secret-access-key

# Encrypted backups; store the age identity offline and recipient public key separately.
AGE_RECIPIENT=age1replace-with-offline-backup-recipient
BACKUP_DIR=/mnt/arm-encrypted-backups
# Restore drills must use a dedicated isolated, empty S3 bucket and restricted credentials.
RESTORE_S3_ENDPOINT=https://s3-restore.example.com
RESTORE_S3_BUCKET=arm-restore-drill-only
RESTORE_S3_REGION=us-east-1
RESTORE_S3_ACCESS_KEY_ID=replace-with-restore-only-access-key
RESTORE_S3_SECRET_ACCESS_KEY_FILE=/secure/secrets/arm-restore-s3-secret-access-key
AGE_IDENTITY=/secure/offline/age-identity.txt
