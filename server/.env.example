NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://arm_runtime:replace-with-runtime-password@localhost:5432/arm
WORKER_DATABASE_URL=postgres://arm_worker:replace-with-worker-password@localhost:5432/arm
MIGRATION_DATABASE_URL=postgres://arm_migrator:replace-with-migrator-password@localhost:5432/arm
ARM_MIGRATOR_PASSWORD=replace-with-a-fourth-random-migrator-password
# Database role passwords must be URL-safe hex: openssl rand -hex 32 (use a distinct value for each role).
# Generate JWT_SECRET with: openssl rand -base64 48. Use a different secret per environment.
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
LOG_LEVEL=info
# Required by server/compose.yaml for the local PostgreSQL container.
POSTGRES_PASSWORD=replace-with-a-long-random-owner-password
ARM_RUNTIME_PASSWORD=replace-with-a-different-random-runtime-password
ARM_WORKER_PASSWORD=replace-with-a-third-random-worker-password

# Production private S3-compatible evidence storage
OBJECT_STORAGE_MODE=s3
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=arm-private-evidence
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-limited-scope-access-key
S3_SECRET_ACCESS_KEY_FILE=/secure/secrets/arm-s3-secret-access-key
