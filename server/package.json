{
  "name": "@arm/cloud-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/migrate.ts",
    "test": "npm run migrate && npm run migrate && tsx --test tests/*.test.ts",
    "db:bootstrap-runtime": "node scripts/bootstrap-runtime-role.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.3.3",
    "pg": "^8.16.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
